<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carpool.frontend.controller.RideHistoryController">
   <children>
      <VBox layoutX="20.0" layoutY="20.0" spacing="20.0">
         <children>
            <Label text="Ride History" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            
            <HBox spacing="20.0">
               <children>
                  <Label text="Filter:" style="-fx-font-size: 14px;" />
                  <ComboBox fx:id="filterComboBox" prefWidth="150.0" />
                  <Button text="Apply Filter" onAction="#applyFilter" prefWidth="120.0" />
                  <Button text="Export History" onAction="#exportHistory" prefWidth="120.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" />
               </children>
            </HBox>
            
            <VBox spacing="10.0">
               <children>
                  <Label text="Your Ride History" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                  <ListView fx:id="rideHistoryListView" prefWidth="700.0" prefHeight="400.0" />
               </children>
            </VBox>
            
            <VBox spacing="10.0">
               <children>
                  <Label text="Summary Statistics" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                  <HBox spacing="30.0">
                     <children>
                        <Label fx:id="totalRidesLabel" text="Total Rides: 0" style="-fx-font-size: 14px;" />
                        <Label fx:id="completedRidesLabel" text="Completed: 0" style="-fx-font-size: 14px;" />
                        <Label fx:id="cancelledRidesLabel" text="Cancelled: 0" style="-fx-font-size: 14px;" />
                        <Label fx:id="totalSpentLabel" text="Total Spent: $0.00" style="-fx-font-size: 14px;" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <HBox spacing="15.0">
               <children>
                  <Button text="Back to Dashboard" onAction="#goBack" prefWidth="150.0" />
                  <Button text="Refresh" onAction="#refreshHistory" prefWidth="100.0" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
