<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carpool.frontend.controller.ProfileController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="My Profile" styleClass="label-header" />
    <Label fx:id="roleLabel" styleClass="label-subheader" style="-fx-font-weight: bold; -fx-font-size: 14;" />

    <Label fx:id="statusLabel" styleClass="label-subheader" style="-fx-text-fill: #10b981; -fx-font-weight: bold;" />

    <VBox spacing="10" maxWidth="350">
        <Label text="Full Name" styleClass="label-field" />
        <TextField fx:id="nameField" styleClass="text-field" />

        <Label text="Email" textFill="#334155" />
        <TextField fx:id="emailField" style="-fx-pref-height: 40; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />

        <Label text="Phone Number" textFill="#334155" />
        <TextField fx:id="phoneField" style="-fx-pref-height: 40; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />
    </VBox>

    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Button mnemonicParsing="false" onAction="#goToDashboard" text="Back to Dashboard" styleClass="button-secondary" style="-fx-pref-width: 150;" />
        <Button mnemonicParsing="false" onAction="#handleSaveChanges" text="Save Changes" styleClass="button-success" style="-fx-pref-width: 150;" />
    </HBox>

</VBox>
