<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carpool.frontend.controller.ManageRideController" styleClass="root">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Manage Active Ride" styleClass="label-header" />

    <VBox spacing="10" styleClass="card" alignment="CENTER_LEFT" maxWidth="400">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <Label fx:id="routeLabel" text="..." style="-fx-font-weight: bold; -fx-font-size: 16px;" />
        <Label fx:id="timeLabel" text="..." />
        <Label fx:id="seatsLabel" text="..." />
        <Label fx:id="fareLabel" text="..." />
        <Label fx:id="statusLabel" text="..." />
    </VBox>

    <Label fx:id="actionStatusLabel" style="-fx-font-weight: bold; -fx-padding: 5 0 0 0;" />

    <HBox fx:id="startRideBox" spacing="10" alignment="CENTER" visible="false">
         <TextField fx:id="otpField" promptText="Enter Start OTP" styleClass="text-field" prefWidth="120" />
         <Button mnemonicParsing="false" onAction="#handleStartRide" text="Start Ride" styleClass="button-success" />
    </HBox>

    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="completeButton" mnemonicParsing="false" onAction="#handleCompleteRide" text="Complete Ride" styleClass="button-success" style="-fx-pref-width: 150;" />
        <Button mnemonicParsing="false" onAction="#handleCancelRide" text="Cancel Ride" styleClass="button-danger" style="-fx-pref-width: 150;" />
    </HBox>

    <Button mnemonicParsing="false" onAction="#goToDashboard" text="Back to Dashboard" styleClass="button-secondary" style="-fx-pref-width: 200;" />

</VBox>
