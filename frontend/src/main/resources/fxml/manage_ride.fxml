<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carpool.frontend.controller.ManageRideController" styleClass="root">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Manage Active Ride" styleClass="label-header" />

    <VBox spacing="10" styleClass="card" alignment="CENTER_LEFT" maxWidth="400">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <Label fx:id="routeLabel" text="..." style="-fx-font-weight: bold; -fx-font-size: 16px;" />
        <Label fx:id="timeLabel" text="..." />
        <Label fx:id="seatsLabel" text="..." />
        <Label fx:id="fareLabel" text="..." />
        <Label fx:id="statusLabel" text="..." />
    </VBox>

    <Label text="Bookings" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-padding: 15 0 10 0; -fx-text-fill: #38bdf8;" />
    <javafx.scene.control.ListView fx:id="bookingsListView" styleClass="card" VBox.vgrow="ALWAYS" prefHeight="400" maxHeight="600" />

    <Label fx:id="actionStatusLabel" style="-fx-font-weight: bold; -fx-padding: 5 0 0 0;" />
    <Label text="Use the buttons below to change ride status" style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />

    <HBox fx:id="startRideBox" spacing="10" alignment="CENTER" visible="false" managed="false">
         <TextField fx:id="otpField" promptText="Enter Start OTP" styleClass="text-field" prefWidth="120" />
         <Button mnemonicParsing="false" onAction="#handleStartRide" text="Start Ride" styleClass="button-success" />
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="ongoingButton" mnemonicParsing="false" onAction="#handleSetOngoing" text="Set Ongoing" styleClass="button-warning" style="-fx-pref-width: 120;" />
        <Button fx:id="completedButton" mnemonicParsing="false" onAction="#handleSetCompleted" text="Set Completed" styleClass="button-success" style="-fx-pref-width: 120;" />
        <Button fx:id="cancelledButton" mnemonicParsing="false" onAction="#handleSetCancelled" text="Set Cancelled" styleClass="button-danger" style="-fx-pref-width: 120;" />
    </HBox>

    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="completeButton" mnemonicParsing="false" onAction="#handleCompleteRide" text="Complete Ride &amp; Payment" styleClass="button-success" style="-fx-pref-width: 150;" />
        <Button mnemonicParsing="false" onAction="#handleViewPaymentStatus" text="View Payment Status" styleClass="button-info" style="-fx-pref-width: 150;" />
    </HBox>

    <HBox spacing="15" alignment="CENTER">
        <Button mnemonicParsing="false" onAction="#refreshRide" text="Refresh" styleClass="button-secondary" style="-fx-pref-width: 120;" />
        <Button mnemonicParsing="false" onAction="#goToDashboard" text="Back to Dashboard" styleClass="button-secondary" style="-fx-pref-width: 200;" />
    </HBox>

</VBox>
